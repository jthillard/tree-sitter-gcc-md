{
  "name": "tree-sitter-gcc-md",
  "version": "0.1.0",
  "description": "GCC Machine Description grammar for tree-sitter",
  "repository": "https://github.com/jthillard/tree-sitter-gcc-md",
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Pietro Monteiro",
    "email": "pietro@sociotechnical.xyz"
  },
  "contributors": [
    {
      "name": "Julien Thillard",
      "email": "julien.thillard38@gmail.com"
    }
  ],
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "gcc_md"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "eslint": "^9.15.0",
    "eslint-config-treesitter": "^1.0.2",
    "prebuildify": "^6.0.1",
    "tree-sitter-cli": "^0.26.7",
    "tree-sitter": "^0.25.0"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "lint": "eslint grammar.js",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js"
  }
}
